# ============================================
# Configuração do Sistema de Gestão de Incidentes
# ============================================

# SERVIDOR
PORT=3001

# ============================================
# DATABASE (SQL Server)
# ============================================
DB_USER=incident_user
DB_PASS=Incident123!
DB_SERVER=localhost
DB_NAME=IncidentDB

# ============================================
# AUTENTICAÇÃO (JWT)
# ============================================
JWT_SECRET=umaCoisaBemSecreta123
JWT_EXPIRES=8h

# ============================================
# Notas:
# ============================================
# 1. Muda PORT se 3001 já está em uso
# 2. DB_USER: Utilizador do SQL Server
# 3. DB_PASS: Password do utilizador SQL Server
# 4. DB_SERVER: localhost ou endereço do servidor
# 5. DB_NAME: Nome da base de dados
# 6. JWT_SECRET: Chave forte para assinar tokens (muda em produção!)
# 7. JWT_EXPIRES: Tempo de expiração (ex: 8h, 7d, 24h)
